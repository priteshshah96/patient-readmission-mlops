# Docker Environment Configuration for Patient Readmission MLOps
# Copy this to .env.docker and customize for your deployment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# =============================================================================
# MLFLOW CONFIGURATION
# =============================================================================
# MLflow Tracking Server URL (update for your setup)
MLFLOW_TRACKING_URI=http://mlflow:5000

# Model Configuration
MODEL_NAME=patient_readmission_predictor
MODEL_STAGE=Production
MODEL_VERSION=latest

# =============================================================================
# API CONFIGURATION
# =============================================================================
# API Settings
APP_VERSION=1.0.0
BATCH_SIZE_LIMIT=100
PREDICTION_THRESHOLD=0.5

# CORS Settings (comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://yourdomain.com"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# =============================================================================
# AZURE STORAGE CONFIGURATION
# =============================================================================
# Azure Blob Storage (replace with your actual values)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account;AccountKey=your_access_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_CONTAINER_NAME=patient-data

# Azure Container Registry (for deployment)
AZURE_CONTAINER_REGISTRY=your_registry.azurecr.io
IMAGE_NAME=patient-readmission-api
IMAGE_TAG=latest

# =============================================================================
# DATABASE CONFIGURATION (for production MLflow)
# =============================================================================
# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow123

# MLflow Backend Store URI (for production)
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow123@postgres:5432/mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Prometheus Configuration
PROMETHEUS_URL=http://prometheus:9090

# Grafana Configuration
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_PASSWORD=admin123

# Application Insights (Azure)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# API Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SSL/TLS
SSL_VERIFY=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Uvicorn Worker Configuration
WORKERS=1
MAX_WORKERS=4
WORKER_CONNECTIONS=1000
KEEP_ALIVE=30

# Memory Settings
MAX_MEMORY_MB=512
GC_THRESHOLD=100

# Cache Settings (if using Redis)
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# These settings are used when APP_ENV=development
DEV_DEBUG=true
DEV_LOG_LEVEL=DEBUG
DEV_RELOAD=true
DEV_CORS_ORIGINS=["*"]

# =============================================================================
# AZURE CONTAINER APPS SPECIFIC
# =============================================================================
# These are set automatically by Azure Container Apps
# CONTAINER_APP_NAME=patient-readmission-api
# CONTAINER_APP_REVISION=patient-readmission-api--revision
# CONTAINER_APP_REPLICA_NAME=patient-readmission-api--replica

# Azure Resource Configuration
AZURE_RESOURCE_GROUP=rg-patient-readmission
AZURE_LOCATION=eastus
AZURE_SUBSCRIPTION_ID=your-subscription-id

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_BATCH_PREDICTIONS=true
ENABLE_MODEL_RETRAINING=false
ENABLE_A_B_TESTING=false
ENABLE_CACHING=true
ENABLE_METRICS_COLLECTION=true

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# =============================================================================
# DATA PROCESSING
# =============================================================================
# Feature Engineering
FEATURE_SELECTION_THRESHOLD=0.01
SMOTE_SAMPLING_STRATEGY=auto
CROSS_VALIDATION_FOLDS=5

# Model Training
EARLY_STOPPING_ROUNDS=10
MAX_EVAL_METRIC=0.95

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================
# Data Governance
DATA_RETENTION_DAYS=90
AUDIT_LOG_LEVEL=INFO
GDPR_COMPLIANCE=true

# Model Governance
MODEL_APPROVAL_REQUIRED=true
MODEL_TESTING_REQUIRED=true
MODEL_DOCUMENTATION_REQUIRED=true