# =============================================================================
# ESSENTIAL CONFIGURATION FOR PATIENT READMISSION MLOPS
# =============================================================================

# MLflow Configuration (Docker)
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_NAME=patient_readmission_predictor
MODEL_STAGE=Production

# API Configuration
DEBUG=true
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Azure Storage (Replace with your values)
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string_here
AZURE_STORAGE_ACCOUNT_NAME=your_account_name
AZURE_CONTAINER_NAME=patient-data

# =============================================================================
# QUICK START INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update Azure storage credentials above
# 3. Run: docker-compose up -d
# 4. Train model: docker-compose exec api python -m src.models.train
# 5. API will be ready at http://localhost:8000
